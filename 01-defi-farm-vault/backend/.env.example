# Copy to .env and fill in. Every value is validated at boot, so a typo fails fast.

NODE_ENV=development
LOG_LEVEL=debug

PORT=4002
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://bscfarm:bscfarm@localhost:5434/bscfarm?schema=public

# 56 = BSC mainnet, 97 = BSC testnet, 204 = opBNB
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Printed by the deploy script.
REWARD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
MASTERCHEF_ADDRESS=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS=0xD99D1c33F9fC3444f8101754aBC46c52416550D1
# Optional. Without an oracle, TVL and APR are unavailable rather than guessed.
ORACLE_ADDRESS=
# Optional. Without a vault, the vault routes and keeper stay off.
VAULT_ADDRESS=

# BSC produces a block roughly every 3 seconds. Blocks below (head - CONFIRMATIONS) are treated as
# final; above it, logs are re-scanned every pass so a reorg cannot leave a phantom deposit behind.
CONFIRMATIONS=15
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=6
DEPLOY_BLOCK=0

# How often to sample pool TVL and APR, in seconds. Neither emits an event, so sampling is the only
# way to have a history to chart.
SNAPSHOT_INTERVAL=900

# --- Compound keeper -------------------------------------------------------
# Leave KEEPER_PRIVATE_KEY empty to disable the keeper entirely.
#
# In production run the keeper as its own process (`pnpm keeper`): it holds a signing key, and
# keeping that out of the public HTTP server's process limits the blast radius of an API bug.
KEEPER_PRIVATE_KEY=

KEEPER_INTERVAL=300
# The bounty must be worth at least this multiple of the gas, in basis points. 12000 = 1.2x.
# Compounding at break-even loses money to price movement between estimate and execution.
KEEPER_MIN_PROFIT_BPS=12000
# Refuse to send above this gas price. A spike is worth waiting out; rewards keep accruing.
KEEPER_MAX_GAS_GWEI=10
KEEPER_DEADLINE_SECONDS=120

# Fallback USD price for a freshly launched reward token that no Chainlink feed covers yet.
REWARD_TOKEN_PRICE_USD=
