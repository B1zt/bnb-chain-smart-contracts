# Copy to .env and fill in. Every value is validated at boot, so a typo fails fast.

NODE_ENV=development
LOG_LEVEL=debug

PORT=4003
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://launchpad:launchpad@localhost:5435/launchpad?schema=public

# --- Launchpad -------------------------------------------------------------
# 56 = BSC mainnet, 97 = BSC testnet
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Printed by the deploy script.
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
LOCKER_ADDRESS=0x0000000000000000000000000000000000000000
PRICE_FEED_ADDRESS=

CONFIRMATIONS=15
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=6
DEPLOY_BLOCK=0

# Required for POST /presales/:address/tiers. Publishing an allowlist decides who can buy and how
# much, so that route is not open. Minimum 16 characters.
ADMIN_API_KEY=

# --- Bridge ----------------------------------------------------------------
# Leave RELAYER_PRIVATE_KEY empty to disable the bridge half entirely.
#
# In production run the relayer as its own process (`pnpm relayer`): it holds a signing key.

SOURCE_CHAIN_ID=97
SOURCE_RPC_URL=
SOURCE_BRIDGE_ADDRESS=

DESTINATION_CHAIN_ID=11155111
DESTINATION_RPC_URL=
DESTINATION_BRIDGE_ADDRESS=

# Confirmations before a source transfer is acted on. Relaying an unconfirmed transfer is how a
# bridge mints against a deposit that later reorgs away, so this is higher than the indexer's depth.
BRIDGE_CONFIRMATIONS=20

# Must match the destination bridge's on-chain threshold. GET /bridge/status flags a mismatch.
BRIDGE_THRESHOLD=3

RELAYER_PRIVATE_KEY=
RELAYER_INTERVAL=15
RELAYER_MAX_ATTEMPTS=5

# Validator signing services, comma separated. Each independently verifies the source event before
# signing; that independence is the whole security model.
VALIDATOR_ENDPOINTS=
VALIDATOR_API_KEY=

# Local validator keys for running the pipeline end to end in development, comma separated.
#
# One process holding every validator key is a custodian, not a bridge. The relayer refuses to use
# these unless NODE_ENV=development.
DEV_VALIDATOR_KEYS=
